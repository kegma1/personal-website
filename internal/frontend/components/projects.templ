package components

import (
  "personal_website/repositories"
  "fmt"
)

templ Projects() {
  <div class="projects" hx-get="/projects" hx-trigger="intersect once" hx-target="this" hx-swap="innerHTML"></div>
}

templ ProjectLinks(projects []repositories.Project) {
  for _, project := range projects {
    <a href={ project.Link } target="_blank" rel="noopener noreferrer">
      <img src={ fmt.Sprintf("./static/projectIcons/%s.png", project.Title)} alt={ fmt.Sprintf("%s icon", project.Title)} width="50" height="50">
      <h1>{ project.Title }</h1>
    </a>
  }
}


