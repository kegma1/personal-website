package components

import "personal_website/repositories"
import "strconv"

templ Desktop() {
  @Base("Under construction...") {
    <div class="desktop" x-data="{ nextZ: 10 }">
      <div class="window-cluster">
        @Window("Hello world", "main-window", 2) {
          <div class="under-construction">
            <h1>Under construction...</h1>
          </div>
        }
        @Window("Terminal", "terminal-window", 4) {
          // <div class="under-construction">
          //   <h1>Under construction...</h1>
          // </div>
           <script id="base-vertex-shader" type="x-shader/x-vertex">
              attribute vec3 aVertexPosition;

              attribute vec4 aVertexColor;
              varying lowp vec4 vColor;

              uniform mat4 uModelViewMatrix;
              uniform mat4 uProjectionMatrix;

              void main(void) {
                  gl_Position = uProjectionMatrix * uModelViewMatrix * vec4(aVertexPosition, 1.0);
                  vColor = aVertexColor;
              }
          </script>

          <script id="base-fragment-shader" type="x-shader/x-fragment">
              precision mediump float;

              varying lowp vec4 vColor;

              uniform vec4 uFragColor;
        
              void main(void) {
                 gl_FragColor =  uFragColor + vColor;
              }
          </script>
          <canvas id="myCanvas"</canvas>
          <script type="module">
              import {main} from "./static/main.js";
              main();
          </script>
        }
        @Window("~/Projects", "projects-window", 3) {
          <div class="under-construction">
            <h1>Under construction...</h1>
          </div>
        }
        @Window("Blog", "blog-window", 5) {
          // <div class="under-construction">
          //   <h1>Under construction...</h1>
          // </div>
          @BlogFeed()
        }
      </div>
    </div>
  }
}

templ BlogFeed() {
  <div>
    <ul>
      @nextPage(0)
    </ul>
  </div>  
}

templ PostPage(next int, posts []repositories.Post) {
  if len(posts) > 0 {
    for _, post := range posts {
      <li>
        <h1>{ post.Title }</h1>
        <p>{ post.Subtitle }</p>
        <p>{ post.CreatedAt.Format("02.Jan.2006") }</p>
        // if post.EditedAt.Valid {
        //   <p>{ post.EditedAt.Valid }</p>
        // }
      </li>
    }
    @nextPage(next)
  } else {
    <p>no more posts</p>
  }
}

templ nextPage(page int) {
  <p hx-get={ "/posts/" + strconv.Itoa(page) } hx-trigger="intersect once" hx-target="this" hx-swap="outerHTML">getting posts...</p>
}

