╰──┴─────────────────────────────────╯<br/>
<span style="color: var(--base00)">●</span> <span style="color: var(--base05)">●</span> <span style="color: var(--base08)">●</span> <span style="color: var(--base08)">●</span> <span style="color: var(--base0A)">●</span> <span style="color: var(--base0B)">●</span> <span style="color: var(--base0C)">●</span> <span style="color: var(--base0D)">●</span><br/>
    </code>
  </div>
}

