package components

import "strconv"

templ Window(title string, windowId string, initialZ int) {
  <div
    class="window"
    id={windowId}
    x-data={"{Z: " + strconv.Itoa(initialZ) + "}"}
    @click="Z = nextZ; nextZ++;"
    :style="{ zIndex: Z }"
  >
    <div class="title-bar">
      <div class="close-button"></div>
      <div class="title-bar-text">{title}</div>
      <div class="minimize-button">
        <svg width="15" height="15" viewBox="0 0 15 15">
          <path d="M7.5 0 V7.5 H-7.5" 
                stroke-width="5" 
                stroke-linecap="square"
                fill="none"/>
        </svg>
      </div>
    </div>
    <div class="window-body">
      { children... }
    </div>
  </div>
}

